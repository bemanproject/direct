#ifndef BEMAN_DIRECT_DETAIL_CONFIG_GENERATED_HPP
#define BEMAN_DIRECT_DETAIL_CONFIG_GENERATED_HPP

// ---------------------------------------------------------------------------
// Feature flags (generated by CMake from config_generated.hpp.in — do not edit)
//
// These record decisions CMake made once, at configure time, via
// check_cxx_source_compiles. Baking them into a generated header (rather than
// consulting feature-test macros at preprocessing time) is what keeps
// preprocessing output independent of compiler flags, per the Beman Standard's
// [cpp.no_flag_forking]. See detail/config.hpp for the vendoring fallback.
// ---------------------------------------------------------------------------

#cmakedefine01 BEMAN_DIRECT_USE_CONCEPTS
#cmakedefine01 BEMAN_DIRECT_USE_THREE_WAY_COMPARISON

#endif // BEMAN_DIRECT_DETAIL_CONFIG_GENERATED_HPP
